#!/usr/bin/env python3
"""Control Codex locally or delegate to a host-local CLI over SSH."""

import fcntl
import glob
import json
import os
import shutil
import shlex
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Dict, List, NamedTuple, Optional, Sequence, Tuple


class UserError(RuntimeError):
    pass


class Process(NamedTuple):
    pid: int
    ppid: int
    command: str


HOME = Path.home()
CODEX_HOME = HOME / ".codex"
ACCOUNTS = CODEX_HOME / "accounts"
AUTH = CODEX_HOME / "auth.json"
CURRENT = CODEX_HOME / "current"
LOCK = CODEX_HOME / "appserver-ctl-auth.lock"
UID = os.getuid()
SCRIPT = Path(__file__).resolve()
PROFILE_CHARS = frozenset("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-")


USAGE = """Control Codex and switch auth profiles locally on macOS/Linux or over SSH.

Local execution supports macOS and Linux managed daemons. SSH targets use
their installed host-local script. STAMCord deployment control is not exposed by this interface.

Usage:
  codex-appserver-ctl doctor [--target SSH_TARGET]
  codex-appserver-ctl targets
  codex-appserver-ctl logs [--follow] [--lines N] [--file PATH|--unit UNIT] [--target SSH_TARGET]
  codex-appserver-ctl auth login NAME [--force] [--dry-run] [--target SSH_TARGET]
  codex-appserver-ctl start|restart|stop [--target SSH_TARGET] [--dry-run]
  codex-appserver-ctl remote-control start|stop|pair|enable|disable|status|bootstrap [--target SSH_TARGET] [--dry-run]
  codex-appserver-ctl true|false [--target SSH_TARGET] [--force] [--dry-run] [--timeout N]
  codex-appserver-ctl status [--target SSH_TARGET]
  codex-appserver-ctl auth list [--target SSH_TARGET]
  codex-appserver-ctl auth current [--target SSH_TARGET]
  codex-appserver-ctl auth save NAME [--target SSH_TARGET] [--force] [--dry-run]
  codex-appserver-ctl auth use [NAME] [--target SSH_TARGET] [--restart=true|false] [--dry-run]

Targets:
  Omit --target to operate on this computer.
  --target SSH_TARGET connects using SSH (for example, MY_SERVER or user@host).
  Missing or incompatible remote tools prompt for installation of this version.
  Installation requires confirmation and Python 3.9 or later on the target.
  Remote commands use profiles on the remote host.
  SSH configuration, authentication, and host verification follow normal ssh.

Control policy:
  The official Codex daemon API is used when available. Otherwise only exact
  Codex/ChatGPT application-hosted app-server processes are considered. A
  graceful stop is attempted first; --force permits exact SIGKILL fallback.
  Restart reopens only the application bundle that owned the matched server.

Auth profiles:
  Profiles are owned 0600 JSON files in ~/.codex/accounts. Switching is locked,
  atomic, and rollback-protected. Restart defaults to true, matching the Linux
  script; pass --restart=false to switch files without restarting the app.
"""


def die(message: str) -> None:
    raise UserError(message)


def normalize_target(value: str) -> str:
    value = value.lower()
    if value in {"this", "home", "local", "host", "all", "both"}:
        return "home"
    if value in {"stamcord", "shared", "deployment"}:
        die("STAMCord targets are not available on macOS")
    die("unknown target: %s" % value)
    return "home"


def normalize_bool(value: str) -> bool:
    value = value.lower()
    if value in {"1", "true", "yes", "on"}:
        return True
    if value in {"0", "false", "no", "off"}:
        return False
    die("restart must be true or false: %s" % value)
    return False


def validate_home() -> None:
    if not CODEX_HOME.is_dir() or CODEX_HOME.is_symlink():
        die("Codex home is missing or unsafe: %s" % CODEX_HOME)
    if CODEX_HOME.stat().st_uid != UID:
        die("Codex home has the wrong owner: %s" % CODEX_HOME)


def host_codex() -> Optional[str]:
    configured = os.environ.get("CODEX_APPSERVER_HOST_CODEX")
    candidates = [
        configured,
        shutil.which("codex"),
        str(CODEX_HOME / "packages" / "standalone" / "current" / "codex"),
    ]
    for candidate in candidates:
        if candidate and os.path.isabs(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def codex_env() -> Dict[str, str]:
    env = dict(os.environ)
    env.update({"HOME": str(HOME), "CODEX_HOME": str(CODEX_HOME)})
    return env


def daemon_request(action: str, timeout: int) -> Tuple[bool, str]:
    binary = host_codex()
    if not binary:
        return False, "Codex executable not found"
    try:
        result = subprocess.run(
            [binary, "app-server", "daemon", action],
            env=codex_env(),
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=timeout,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, str(exc)
    output = result.stdout.strip()
    return result.returncode == 0, output


def daemon_status() -> Optional[Dict[str, object]]:
    ok, output = daemon_request("version", 5)
    if not ok:
        return None
    try:
        data = json.loads(output)
    except json.JSONDecodeError:
        return None
    return data if isinstance(data, dict) else None


def process_table() -> List[Process]:
    result = subprocess.run(
        ["/bin/ps", "-axo", "pid=,ppid=,uid=,command="],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    rows: List[Process] = []
    if result.returncode:
        die("could not read the process table")
    for line in result.stdout.splitlines():
        fields = line.strip().split(None, 3)
        if len(fields) != 4:
            continue
        try:
            pid, ppid, uid = map(int, fields[:3])
        except ValueError:
            continue
        if uid == UID:
            rows.append(Process(pid, ppid, fields[3]))
    return rows


def first_word(command: str) -> str:
    return command.split(None, 1)[0] if command else ""


def allowed_codex_binary(binary: str) -> bool:
    app_binaries = {
        "/Applications/Codex.app/Contents/Resources/codex",
        "/Applications/ChatGPT.app/Contents/Resources/codex",
        "/Applications/Codex.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex",
        "/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex",
    }
    selected = host_codex()
    if selected and Path(binary).resolve() == Path(selected).resolve():
        return True
    if binary in app_binaries:
        return True
    home_prefixes = (
        str(CODEX_HOME / "packages" / "standalone") + "/",
        str(HOME / ".local") + "/",
    )
    return binary.endswith("/codex") and binary.startswith(home_prefixes)


def app_servers(table: Optional[Sequence[Process]] = None) -> List[Process]:
    rows = list(table) if table is not None else process_table()
    matches = []
    for proc in rows:
        binary = first_word(proc.command)
        if not allowed_codex_binary(binary):
            continue
        if "app-server" not in proc.command or "app-server proxy" in proc.command:
            continue
        matches.append(proc)
    return matches


def app_bundle_for(command: str) -> Optional[str]:
    binary = first_word(command)
    if binary.startswith("/Applications/Codex.app/"):
        return "Codex"
    if binary.startswith("/Applications/ChatGPT.app/"):
        return "ChatGPT"
    return None


def control_targets(servers: Sequence[Process], table: Sequence[Process]) -> Tuple[List[int], List[str]]:
    by_pid = {proc.pid: proc for proc in table}
    pids = set()
    apps = set()
    for server in servers:
        parent = by_pid.get(server.ppid)
        app = app_bundle_for(parent.command) if parent else None
        if app and parent:
            pids.add(parent.pid)
            apps.add(app)
        else:
            pids.add(server.pid)
    return sorted(pids), sorted(apps)


def version_string() -> str:
    binary = host_codex()
    if not binary:
        return "unknown"
    try:
        result = subprocess.run(
            [binary, "--version"],
            env=codex_env(),
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    return result.stdout.strip().replace("codex-cli ", "") or "unknown"


def print_status() -> None:
    daemon = daemon_status()
    if daemon and daemon.get("status") == "running":
        version = daemon.get("appServerVersion", "unknown")
        print("target=home state=running version=%s transport=unix:// authority=codex-daemon" % version)
        return
    if sys.platform.startswith("linux"):
        if daemon is None:
            die("managed daemon status unavailable; run start or check codex app-server daemon version")
        print(json.dumps(daemon))
        return
    servers = app_servers()
    if servers:
        pids = ",".join(str(proc.pid) for proc in servers)
        print(
            "target=home state=running pids=%s version=%s transport=embedded authority=app-host"
            % (pids, version_string())
        )
    else:
        print("target=home state=not-running pids=none version=%s authority=stopped" % version_string())


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def wait_pids_gone(pids: Sequence[int], seconds: int) -> bool:
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if not any(pid_alive(pid) for pid in pids):
            return True
        time.sleep(0.25)
    return not any(pid_alive(pid) for pid in pids)


def current_ancestry(table: Sequence[Process]) -> set:
    parents = {proc.pid: proc.ppid for proc in table}
    result = set()
    pid = os.getpid()
    while pid > 1 and pid not in result:
        result.add(pid)
        pid = parents.get(pid, 0)
    return result


def schedule_command(arguments: Sequence[str], description: str) -> None:
    fd, name = tempfile.mkstemp(prefix="appserver-ctl-detached.", suffix=".log", dir=str(CODEX_HOME))
    log_path = Path(name)
    command = [sys.executable, str(SCRIPT)] + list(arguments)
    with os.fdopen(fd, "wb", closefd=True) as log:
        subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
            close_fds=True,
        )
    print("scheduled %s launcher=start_new_session log=%s" % (description, log_path))


def schedule_control(restart: bool, force: bool, timeout: int) -> None:
    command = [str(restart).lower(), "--internal-direct", "--timeout", str(timeout)]
    if force:
        command.append("--force")
    schedule_command(command, "mode=control target=home restart=%s" % str(restart).lower())


def schedule_auth_use(name: str, force: bool, timeout: int) -> None:
    command = [
        "auth",
        "use",
        name,
        "--restart=true",
        "--internal-direct",
        "--timeout",
        str(timeout),
    ]
    if force:
        command.append("--force")
    schedule_command(command, "mode=auth target=home profile=%s restart=true" % name)


def control_home(restart: bool, force: bool, dry_run: bool, timeout: int, internal: bool = False) -> None:
    action = "restart" if restart else "stop"
    if not dry_run and not internal and within_appserver():
        schedule_control(restart, force, timeout)
        return
    if internal:
        time.sleep(1.0)
    if sys.platform.startswith("linux"):
        if dry_run:
            run_codex(["app-server", "daemon", action], True, timeout)
            return
        ok, output = daemon_request(action, timeout)
        if not ok:
            die("managed daemon %s failed: %s" % (action, output))
        if output:
            print(output)
        return
    daemon = daemon_status()
    if daemon and daemon.get("status") == "running":
        if dry_run:
            print("dry-run target=home action=%s detected_authority=codex-daemon" % action)
            return
        ok, output = daemon_request(action, timeout)
        if ok:
            print("home_control authority=codex-daemon action=%s result=accepted" % action)
            print_status()
            return
        print("warning: official daemon %s failed: %s" % (action, output.splitlines()[-1] if output else "unknown"), file=sys.stderr)

    table = process_table()
    servers = app_servers(table)
    targets, apps = control_targets(servers, table)
    if dry_run:
        authority = "app-host" if targets else "stopped"
        print(
            "dry-run target=home action=%s detected_authority=%s target_pids=%s apps=%s force=%s"
            % (action, authority, ",".join(map(str, targets)) or "none", ",".join(apps) or "none", str(force).lower())
        )
        if targets and set(targets) & current_ancestry(table):
            print("dry-run caller_is_within_target=true would_schedule_detached=true")
        return

    if not targets:
        if restart:
            die("no managed daemon or application-hosted app-server was found to restart")
        print("home_control action=stop result=already-stopped")
        return

    if restart and not apps:
        die("cannot restart an unmanaged standalone app-server; use a managed daemon")

    if not internal and set(targets) & current_ancestry(table):
        schedule_control(restart, force, timeout)
        return
    if internal:
        time.sleep(1.0)
        table = process_table()
        servers = app_servers(table)
        targets, apps = control_targets(servers, table)
        if not targets:
            if restart:
                die("target exited before detached restart could identify it")
            return

    for pid in targets:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    grace = min(timeout, 15)
    if not wait_pids_gone(targets, grace):
        if not force:
            die("exact Codex host ignored graceful termination; rerun with --force to permit SIGKILL")
        for pid in targets:
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        if not wait_pids_gone(targets, min(timeout, 10)):
            die("exact Codex host is still running after SIGKILL")

    if restart:
        if not apps:
            die("the standalone app-server stopped, but no application bundle was available to reopen")
        for app in apps:
            result = subprocess.run(["/usr/bin/open", "-a", app], check=False)
            if result.returncode != 0:
                die("could not reopen application: %s" % app)
        print("home_control action=restart result=reopened apps=%s" % ",".join(apps))
    else:
        print("home_control action=stop result=stopped")


def within_appserver() -> bool:
    table = process_table()
    targets, _ = control_targets(app_servers(table), table)
    return bool(set(targets) & current_ancestry(table))


def run_codex(arguments: Sequence[str], dry_run: bool, timeout: int) -> None:
    binary = host_codex()
    if not binary:
        die("Codex executable not found; install codex or set CODEX_APPSERVER_HOST_CODEX")
    command = [binary] + list(arguments)
    if dry_run:
        print("dry-run command=%s" % shlex.join(command))
        return
    try:
        result = subprocess.run(command, env=codex_env(), timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        die("Codex command failed: %s" % exc)
    if result.returncode:
        die("Codex command exited with status %s" % result.returncode)


def remote_control(args: Sequence[str]) -> None:
    options = parse_options(args)
    if len(options.positionals) != 1:
        die("remote-control requires start, stop, pair, enable, disable, status, or bootstrap")
    action = options.positionals[0]
    commands = {
        "bootstrap": ["app-server", "daemon", "bootstrap", "--remote-control"],
        "start": ["remote-control", "start"],
        "stop": ["remote-control", "stop"],
        "pair": ["remote-control", "pair"],
        "enable": ["app-server", "daemon", "enable-remote-control"],
        "disable": ["app-server", "daemon", "disable-remote-control"],
        "status": ["app-server", "daemon", "version"],
    }
    if action not in commands:
        die("unknown remote-control command: %s" % action)
    if not options.dry_run and not options.internal and action in {"start", "stop", "enable", "disable", "bootstrap"} and within_appserver():
        schedule_command(["remote-control"] + list(args) + ["--internal-direct"], "remote-control action=%s" % action)
        return
    if options.internal:
        time.sleep(1.0)
    run_codex(commands[action], options.dry_run, options.timeout)


def ssh_aliases(configs: Sequence[Path]) -> List[str]:
    aliases = set()
    visited = set()

    def read(path: Path) -> None:
        path = path.resolve()
        if path in visited or not path.is_file():
            return
        visited.add(path)
        for line in path.read_text().splitlines():
            # SSH permits both Keyword value and Keyword=value.
            stripped = line.strip()
            if not stripped or stripped.startswith("#"):
                continue
            head = stripped.split(None, 1)[0]
            if "=" in head:
                stripped = stripped.replace("=", " ", 1)
            try:
                words = shlex.split(stripped, comments=True)
            except ValueError as exc:
                die("invalid SSH config %s: %s" % (path, exc))
            if not words:
                continue
            if words[0].lower() == "host":
                aliases.update(word for word in words[1:] if not any(c in word for c in "*?![") and not word.startswith("-"))
            elif words[0].lower() == "include":
                for pattern in words[1:]:
                    expanded = Path(os.path.expanduser(pattern))
                    if not expanded.is_absolute():
                        base = Path("/etc/ssh") if path.is_relative_to(Path("/etc/ssh")) else HOME / ".ssh"
                        expanded = base / expanded
                    for included in sorted(glob.glob(str(expanded))):
                        read(Path(included))

    for config in configs:
        read(config)
    return sorted(aliases, key=str.casefold)


def doctor(args: Sequence[str]) -> None:
    options = parse_options(args)
    if options.positionals:
        die("doctor accepts options only")
    failed = False

    def report(label: str, state: str, detail: str) -> None:
        nonlocal failed
        print("%s %s: %s" % (state, label, detail))
        failed = failed or state == "FAIL"

    binary = host_codex()
    report("codex", "OK" if binary else "FAIL", binary or "executable not found")
    if binary:
        report("version", "OK", version_string())
    try:
        validate_home()
        report("home", "OK", str(CODEX_HOME))
        active = active_profile_path()
        report("auth", "OK" if active else "WARN", "valid owned 0600 auth" if active else "not logged in")
        if ACCOUNTS.exists():
            if ACCOUNTS.is_symlink() or not ACCOUNTS.is_dir() or ACCOUNTS.stat().st_uid != UID:
                report("profiles", "FAIL", "unsafe account store")
            else:
                invalid = sum(not secure_profile(p) for p in ACCOUNTS.glob("*.json"))
                report("profiles", "FAIL" if invalid else "OK", "%s valid, %s invalid" % (len(profile_names()), invalid))
    except UserError as exc:
        report("auth", "FAIL", str(exc))
    state = daemon_status() if binary else None
    report("daemon", "OK" if state else "WARN", str(state.get("status", "unknown")) if state else "managed daemon unavailable; macOS may use an app-hosted server")
    if binary:
        for arguments, signature in [
            (["app-server", "daemon", "--help"], "enable-remote-control"),
            (["remote-control", "--help"], "Usage: codex remote-control"),
            (["app-server", "daemon", "bootstrap", "--help"], "--remote-control"),
            (["login", "--help"], "--device-auth"),
        ]:
            try:
                result = subprocess.run([binary] + arguments, env=codex_env(), capture_output=True,
                                        text=True, timeout=min(options.timeout, 10), check=False)
                supported = result.returncode == 0 and signature in result.stdout
            except (OSError, subprocess.TimeoutExpired):
                supported = False
            report(" ".join(arguments[:-1]), "OK" if supported else "FAIL", "supported" if supported else "missing or unavailable; update Codex CLI")
    if failed:
        raise SystemExit(1)


def logs(args: Sequence[str]) -> None:
    follow = False
    lines = 100
    selected = None
    unit = None
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--follow":
            follow = True
        elif arg in {"--file", "--lines", "--unit"}:
            index += 1
            if index >= len(args):
                die("%s requires a value" % arg)
            if arg == "--file":
                selected = Path(args[index]).expanduser()
            elif arg == "--unit":
                unit = args[index]
            else:
                try:
                    lines = int(args[index])
                except ValueError:
                    die("--lines must be an integer")
        elif arg in {"-h", "--help"}:
            print("Usage: codex-appserver-ctl logs [--follow] [--lines N] [--file PATH|--unit UNIT] [--target SSH_TARGET]")
            return
        else:
            die("unknown logs option: %s" % arg)
        index += 1
    if not 1 <= lines <= 10000:
        die("--lines must be between 1 and 10000")
    if unit is not None:
        if selected is not None or not unit or unit.startswith("-"):
            die("--unit requires a unit name and cannot be combined with --file")
        command = ["journalctl", "--user", "--unit=" + unit, "-n", str(lines), "--no-pager"]
        if follow:
            command.append("-f")
        try:
            result = subprocess.run(command, check=False)
        except OSError as exc:
            die("could not read journal: %s" % exc)
        if result.returncode:
            raise SystemExit(result.returncode)
        return
    if selected is None:
        candidates = list(CODEX_HOME.glob("appserver-ctl-detached.*.log"))
        for directory in [CODEX_HOME / "log", CODEX_HOME / "logs", CODEX_HOME / "app-server-control"]:
            if directory.is_dir():
                candidates.extend(p for p in directory.rglob("*.log") if any(word in p.name for word in ["app-server", "app_server", "appserver", "daemon"]))
        candidates = [p for p in candidates if p.is_file()]
        if not candidates:
            die("no daemon or detached-operation log found; specify logs --file PATH")
        selected = max(candidates, key=lambda p: p.stat().st_mtime_ns)
    if not selected.is_file():
        die("log file not found: %s" % selected)
    print("log=%s" % selected, flush=True)
    command = ["tail", "-n", str(lines)]
    if follow:
        command.append("-f")
    command.extend(["--", str(selected)])
    try:
        result = subprocess.run(command, check=False)
    except OSError as exc:
        die("could not read log: %s" % exc)
    if result.returncode:
        raise SystemExit(result.returncode)


def auth_login(name: str, force: bool, dry_run: bool, timeout: int) -> None:
    validate_home()
    name = valid_name(name)
    binary = host_codex()
    if not binary:
        die("Codex executable not found")
    destination = ACCOUNTS / (name + ".json")

    def check_destination() -> None:
        if (ACCOUNTS.exists() or ACCOUNTS.is_symlink()) and (ACCOUNTS.is_symlink() or not ACCOUNTS.is_dir() or ACCOUNTS.stat().st_uid != UID):
            die("account store is unsafe")
        if destination.exists() or destination.is_symlink():
            if not secure_profile(destination):
                die("existing profile is unsafe")
            if not force:
                die("profile already exists; use --force to overwrite")
            if AUTH.is_symlink() and AUTH.resolve() == destination.resolve():
                die("cannot overwrite the directly active profile; use a new name")

    check_destination()
    if dry_run:
        print("dry-run auth_login profile=%s mode=device-auth active=unchanged" % name)
        return
    with tempfile.TemporaryDirectory(prefix="appserver-ctl-login.") as directory:
        env = codex_env()
        env["CODEX_HOME"] = directory
        command = [binary, "-c", 'cli_auth_credentials_store="file"', "login", "--device-auth"]
        try:
            result = subprocess.run(command, env=env, timeout=timeout, check=False)
        except (OSError, subprocess.TimeoutExpired) as exc:
            die("login failed; current auth unchanged: %s" % exc)
        if result.returncode:
            die("login failed; current auth unchanged (exit %s)" % result.returncode)
        source = Path(directory) / "auth.json"
        if not secure_profile(source):
            die("login did not produce a valid owned 0600 auth.json")
        with auth_lock() as lock:
            acquire_lock(lock, timeout)
            check_destination()
            prepare_accounts()
            atomic_bytes(destination, source.read_bytes())
    print("auth_login profile=%s result=saved active=unchanged; use auth use %s to activate" % (name, name))


def valid_name(name: str) -> str:
    if name.endswith(".json"):
        name = name[:-5]
    first_is_ascii_alnum = bool(name) and name[0].isascii() and name[0].isalnum()
    if not first_is_ascii_alnum or len(name) > 128 or any(char not in PROFILE_CHARS for char in name):
        die("invalid profile name: %s" % name)
    return name


def secure_profile(path: Path) -> bool:
    try:
        st = path.lstat()
    except FileNotFoundError:
        return False
    if path.is_symlink() or not path.is_file():
        return False
    if st.st_uid != UID or (st.st_mode & 0o777) != 0o600 or st.st_nlink != 1 or st.st_size > 1024 * 1024:
        return False
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return False
    return isinstance(data, dict) and bool(data)


def profile_names() -> List[str]:
    if not ACCOUNTS.is_dir() or ACCOUNTS.is_symlink() or ACCOUNTS.stat().st_uid != UID:
        return []
    names = []
    for path in sorted(ACCOUNTS.glob("*.json"), key=lambda item: item.name):
        try:
            name = valid_name(path.stem)
        except UserError:
            continue
        if secure_profile(path):
            names.append(name)
    return names


def active_profile_path() -> Optional[Path]:
    if not AUTH.exists() and not AUTH.is_symlink():
        return None
    if AUTH.is_symlink():
        try:
            resolved = AUTH.resolve(strict=True)
            accounts = ACCOUNTS.resolve(strict=True)
        except (FileNotFoundError, RuntimeError):
            die("home auth.json is an invalid link")
        if resolved.parent != accounts or not secure_profile(resolved):
            die("home auth.json is unsafe or escapes the account store")
        return resolved
    if not secure_profile(AUTH):
        die("home auth.json is not an owned 0600 JSON file")
    return AUTH


def current_details() -> str:
    active = active_profile_path()
    if active is None:
        return "target=home current=none source=absent"
    if AUTH.is_symlink():
        return "target=home current=%s source=managed-link" % active.stem
    matches = []
    active_bytes = active.read_bytes()
    for name in profile_names():
        if (ACCOUNTS / (name + ".json")).read_bytes() == active_bytes:
            matches.append(name)
    if len(matches) == 1:
        return "target=home current=%s source=content-match" % matches[0]
    if len(matches) > 1:
        return "target=home current=ambiguous source=duplicate-content"
    return "target=home current=unmanaged source=content"


def prepare_accounts() -> None:
    validate_home()
    if ACCOUNTS.exists() or ACCOUNTS.is_symlink():
        if not ACCOUNTS.is_dir() or ACCOUNTS.is_symlink() or ACCOUNTS.stat().st_uid != UID:
            die("account store is unsafe: %s" % ACCOUNTS)
        ACCOUNTS.chmod(0o700)
    else:
        ACCOUNTS.mkdir(mode=0o700)


def atomic_bytes(destination: Path, content: bytes) -> None:
    fd, name = tempfile.mkstemp(prefix=".appserver-ctl-copy.", dir=str(destination.parent))
    tmp = Path(name)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb", closefd=True) as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(str(tmp), str(destination))
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass


def atomic_link(target: Path, destination: Path) -> None:
    name = destination.parent / (".appserver-ctl-link.%d.%d" % (os.getpid(), time.time_ns()))
    try:
        name.symlink_to(target)
        os.replace(str(name), str(destination))
    finally:
        try:
            name.unlink()
        except FileNotFoundError:
            pass


class Snapshot(NamedTuple):
    kind: str
    value: object


def snapshot(path: Path) -> Snapshot:
    if path.is_symlink():
        return Snapshot("link", os.readlink(str(path)))
    if path.is_file():
        return Snapshot("file", path.read_bytes())
    if path.exists():
        die("transaction path is neither a file nor a symlink: %s" % path)
    return Snapshot("absent", None)


def restore(path: Path, saved: Snapshot) -> None:
    if saved.kind == "absent":
        try:
            path.unlink()
        except FileNotFoundError:
            pass
    elif saved.kind == "file":
        atomic_bytes(path, saved.value)  # type: ignore[arg-type]
    elif saved.kind == "link":
        atomic_link(Path(saved.value), path)  # type: ignore[arg-type]


def auth_lock():
    validate_home()
    if LOCK.exists() or LOCK.is_symlink():
        st = LOCK.lstat()
        if LOCK.is_symlink() or not LOCK.is_file() or st.st_uid != UID or (st.st_mode & 0o777) != 0o600:
            die("auth lock must be an owned 0600 regular file: %s" % LOCK)
    fd = os.open(str(LOCK), os.O_RDWR | os.O_CREAT, 0o600)
    os.fchmod(fd, 0o600)
    return os.fdopen(fd, "r+")


def acquire_lock(stream, timeout: int) -> None:
    deadline = time.monotonic() + timeout
    while True:
        try:
            fcntl.flock(stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            return
        except BlockingIOError:
            if time.monotonic() >= deadline:
                die("timed out waiting for the auth switch lock")
            time.sleep(0.1)


def auth_list() -> None:
    validate_home()
    names = profile_names()
    if names:
        for name in names:
            print("profile=%s" % name)
    else:
        print("profiles=none store=%s" % ACCOUNTS)
    print(current_details())


def auth_save(name: str, force: bool, dry_run: bool, timeout: int) -> None:
    validate_home()
    name = valid_name(name)
    source = active_profile_path()
    if source is None:
        die("home has no valid auth.json to save")
    destination = ACCOUNTS / (name + ".json")
    if destination.exists() or destination.is_symlink():
        if not secure_profile(destination):
            die("existing profile is unsafe: %s" % destination)
        if source.read_bytes() == destination.read_bytes():
            print("auth_save target=home profile=%s result=unchanged" % name)
            return
        if not force:
            die("profile already exists with different content; use --force to overwrite")
        if AUTH.is_symlink() and AUTH.resolve(strict=True) == destination.resolve(strict=True):
            die("cannot overwrite the directly active profile; switch away or use a new name")
    if dry_run:
        print("dry-run auth_save target=home profile=%s overwrite=%s" % (name, str(force).lower()))
        return
    with auth_lock() as lock:
        acquire_lock(lock, timeout)
        prepare_accounts()
        source = active_profile_path()
        if source is None:
            die("home auth.json changed while waiting for the lock")
        atomic_bytes(destination, source.read_bytes())
        if not secure_profile(destination):
            die("saved profile did not pass validation")
    print("auth_save target=home profile=%s result=saved" % name)


def select_profile() -> str:
    names = profile_names()
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        die("auth use requires NAME when stdin/stdout is not a TTY")
    if not names:
        die("no valid auth profiles are available")
    print("Select a Codex auth profile:", file=sys.stderr)
    for index, name in enumerate(names, 1):
        print("  %d) %s" % (index, name), file=sys.stderr)
    answer = input("Profile number: ")
    try:
        index = int(answer)
    except ValueError:
        die("invalid profile selection")
    if index < 1 or index > len(names):
        die("profile selection is out of range")
    return names[index - 1]


def auth_use(
    name: Optional[str], restart: bool, force: bool, dry_run: bool, timeout: int, internal: bool = False
) -> None:
    validate_home()
    if name is None:
        name = select_profile()
    name = valid_name(name)
    profile = ACCOUNTS / (name + ".json")
    if not secure_profile(profile):
        die("profile must be an owned 0600 non-empty JSON object: %s" % profile)
    active_profile_path()
    if dry_run:
        print("dry-run auth_use target=home profile=%s restart=%s" % (name, str(restart).lower()))
        if restart:
            restart_after_auth(force, True, timeout, internal)
        return

    if restart and not internal:
        table = process_table()
        servers = app_servers(table)
        targets, _ = control_targets(servers, table)
        if set(targets) & current_ancestry(table):
            schedule_auth_use(name, force, timeout)
            return

    with auth_lock() as lock:
        acquire_lock(lock, timeout)
        prepare_accounts()
        if not secure_profile(profile):
            die("profile changed while waiting for the lock")
        auth_before = snapshot(AUTH)
        current_before = snapshot(CURRENT)
        try:
            atomic_link(profile, AUTH)
            atomic_bytes(CURRENT, (name + "\n").encode("utf-8"))
            if restart:
                restart_after_auth(force, False, timeout, internal)
            else:
                print("warning: restart disabled; a running app-server may retain the prior auth", file=sys.stderr)
        except Exception:
            restore(CURRENT, current_before)
            restore(AUTH, auth_before)
            raise
    print("auth_use target=home profile=%s restart=%s result=switched" % (name, str(restart).lower()))


def restart_after_auth(force: bool, dry_run: bool, timeout: int, internal: bool) -> None:
    daemon = daemon_status()
    if not (daemon and daemon.get("status") == "running") and not app_servers():
        print("%sauth_restart result=skipped reason=no-running-app-server" % ("dry-run " if dry_run else ""))
        return
    control_home(True, force, dry_run, timeout, internal=internal)


class Options(NamedTuple):
    positionals: List[str]
    restart: Optional[bool]
    force: bool
    dry_run: bool
    timeout: int
    internal: bool


def parse_options(args: Sequence[str]) -> Options:
    positionals: List[str] = []
    restart: Optional[bool] = None
    force = False
    dry_run = False
    timeout = 120
    internal = False
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--force":
            force = True
        elif arg == "--dry-run":
            dry_run = True
        elif arg == "--internal-direct":
            internal = True
        elif arg == "--restart":
            restart = True
        elif arg == "--no-restart":
            restart = False
        elif arg.startswith("--restart="):
            restart = normalize_bool(arg.split("=", 1)[1])
        elif arg == "--timeout":
            index += 1
            if index >= len(args):
                die("--timeout requires a value")
            try:
                timeout = int(args[index])
            except ValueError:
                die("timeout must be a positive integer")
        elif arg.startswith("--timeout="):
            try:
                timeout = int(arg.split("=", 1)[1])
            except ValueError:
                die("timeout must be a positive integer")
        elif arg in {"-h", "--help"}:
            print(USAGE)
            raise SystemExit(0)
        elif arg.startswith("-"):
            die("unknown option: %s" % arg)
        else:
            positionals.append(arg)
        index += 1
    if timeout < 1 or timeout > 900:
        die("timeout must be between 1 and 900 seconds")
    return Options(positionals, restart, force, dry_run, timeout, internal)


def ssh_target(args: Sequence[str]) -> Tuple[Optional[str], List[str]]:
    target = None
    remaining = []
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--target" or arg.startswith("--target="):
            if target is not None:
                die("--target was specified more than once")
            if arg == "--target":
                index += 1
                if index >= len(args):
                    die("--target requires an SSH destination")
                target = args[index]
            else:
                target = arg.split("=", 1)[1]
            if not target or target.startswith("-") or any(c.isspace() or ord(c) < 32 for c in target):
                die("invalid SSH destination")
        else:
            remaining.append(arg)
        index += 1
    return target, remaining


REMOTE_LOOKUP = 'ctl=$(command -v codex-appserver-ctl) || ctl="$HOME/.local/bin/codex-appserver-ctl"; '
REMOTE_INSTALLED = 'ctl="$HOME/.local/bin/codex-appserver-ctl"; '
REMOTE_INSTALLER = r"""
import os
from pathlib import Path
import shutil
import sys
import tempfile

if sys.version_info < (3, 9):
    sys.exit("Python 3.9 or later is required on target")
source = sys.stdin.buffer.read()
compile(source, "codex-appserver-ctl", "exec")
directory = Path.home() / ".local" / "bin"
directory.mkdir(parents=True, exist_ok=True)
destination = directory / "codex-appserver-ctl"
if destination.is_symlink() or (destination.exists() and not destination.is_file()):
    sys.exit("Refusing to replace a symlink or non-regular file: " + str(destination))
if destination.exists() and destination.stat().st_uid != os.getuid():
    sys.exit("Refusing to replace a file owned by another user")
fd, temporary = tempfile.mkstemp(prefix=".codex-appserver-ctl.", dir=directory)
try:
    with os.fdopen(fd, "wb") as file:
        file.write(source)
        file.flush()
        os.fsync(file.fileno())
    os.chmod(temporary, 0o755)
    if destination.exists():
        fd, backup = tempfile.mkstemp(prefix="codex-appserver-ctl.backup.", dir=directory)
        os.close(fd)
        shutil.copy2(destination, backup)
        print("Previous version: " + backup)
    os.replace(temporary, destination)
    print("Installed: " + str(destination))
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
"""


def remote_command_supported(help_text: str, args: Sequence[str]) -> bool:
    if not args or args[0] in {"-h", "--help", "status", "true", "false"}:
        return True
    if args[0] == "auth":
        return len(args) < 2 or args[1] != "login" or "auth login" in help_text
    if args[0] == "remote-control":
        return "remote-control" in help_text and (len(args) < 2 or args[1] in help_text)
    if args[0] in {"restart", "stop"}:
        return True  # Older scripts accept home true|false.
    return args[0] in help_text


def prepare_remote(target: str, args: Sequence[str]) -> bool:
    command = REMOTE_LOOKUP + '[ -x "$ctl" ] || exit 127; "$ctl" --help'
    try:
        result = subprocess.run(["ssh", "--", target, command], capture_output=True, text=True, check=False)
    except OSError as exc:
        die("could not run ssh: %s" % exc)
    if result.returncode == 0 and remote_command_supported(result.stdout, args):
        return False
    if result.returncode not in {0, 127}:
        if result.stderr:
            print(result.stderr.rstrip(), file=sys.stderr)
        raise SystemExit(result.returncode)
    reason = "is not installed" if result.returncode == 127 else "does not support the requested command"
    print("codex-appserver-ctl on %s %s." % (target, reason), file=sys.stderr)
    if "--dry-run" in args:
        die("remote installation is required; dry-run does not install or update files")
    if not sys.stdin.isatty():
        die("remote installation requires confirmation in an interactive terminal")
    print("Install this local version on %s at ~/.local/bin/codex-appserver-ctl?" % target, file=sys.stderr)
    print("Existing files at that path will be backed up. Then the requested command will run.", file=sys.stderr)
    print("The target requires Python 3.9 or later. Authentication files will not be copied.", file=sys.stderr)
    try:
        answer = input("Install/update? [y/N] ").strip().lower()
    except EOFError:
        answer = ""
    if answer not in {"y", "yes"}:
        die("remote installation declined; no files changed")
    command = "python3 -c " + shlex.quote(REMOTE_INSTALLER)
    try:
        result = subprocess.run(["ssh", "-T", "--", target, command], input=SCRIPT.read_bytes(), check=False)
    except OSError as exc:
        die("remote installation failed: %s" % exc)
    if result.returncode:
        die("remote installation failed (exit %s); requested command was not run" % result.returncode)
    return True


def run_remote(target: str, args: Sequence[str]) -> None:
    installed = prepare_remote(target, args)
    # Older host scripts still require the positional home target.
    legacy = list(args)
    if legacy[:1] == ["auth"] and len(legacy) >= 2:
        legacy.insert(2, "home")
    elif legacy[:1] == ["status"]:
        legacy.insert(1, "home")
    elif legacy[:1] in (["restart"], ["stop"]):
        legacy[0:1] = ["home", "false" if legacy[0] == "stop" else "true"]
    elif legacy and legacy[0] not in {"--help", "-h", "remote-control", "start"}:
        legacy.insert(0, "home")
    command = (
        (REMOTE_INSTALLED if installed else REMOTE_LOOKUP)
        + '[ -x "$ctl" ] || { echo "codex-appserver-ctl is not installed on target" >&2; exit 127; }; '
        'ctl_help=$("$ctl" --help) || exit $?; '
        'case "$ctl_help" in *"auth use [NAME]"*) exec "$ctl" '
        + shlex.join(args)
        + ' ;; *) exec "$ctl" '
        + shlex.join(legacy)
        + ' ;; esac'
    )
    ssh = ["ssh"]
    if sys.stdin.isatty() and sys.stdout.isatty():
        ssh.append("-t")
    ssh.extend(["--", target, command])
    try:
        result = subprocess.run(ssh, check=False)
    except OSError as exc:
        die("could not run ssh: %s" % exc)
    raise SystemExit(result.returncode)


def main(argv: Sequence[str]) -> None:
    target, argv = ssh_target(argv)
    if target is not None:
        run_remote(target, argv)
    if not argv or argv[0] in {"-h", "--help"}:
        print(USAGE)
        return
    if argv[0] == "doctor":
        doctor(argv[1:])
        return
    if argv[0] == "targets":
        if len(argv) != 1:
            die("targets accepts no arguments")
        for alias in ssh_aliases([HOME / ".ssh" / "config", Path("/etc/ssh/ssh_config")]):
            print(alias)
        return
    if argv[0] == "logs":
        logs(argv[1:])
        return
    if argv[0] == "remote-control":
        remote_control(argv[1:])
        return
    if argv[0] in {"start", "restart", "stop"}:
        options = parse_options(argv[1:])
        if options.positionals or options.restart is not None:
            die("start/restart/stop accept options only")
        if argv[0] == "start":
            run_codex(["app-server", "daemon", "start"], options.dry_run, options.timeout)
        else:
            control_home(argv[0] == "restart", options.force, options.dry_run, options.timeout, options.internal)
        return
    if argv[0] == "status":
        options = parse_options(argv[1:])
        if len(options.positionals) > 1:
            die("status accepts at most one target")
        if options.positionals:
            normalize_target(options.positionals[0])
        print_status()
        return
    if argv[0] == "auth":
        if len(argv) < 2:
            die("auth requires a command: list, current, login, save, or use")
        command = argv[1]
        options = parse_options(argv[2:])
        positionals = list(options.positionals)
        if command == "list":
            if positionals:
                die("auth list does not accept a profile name")
            auth_list()
        elif command == "current":
            if positionals:
                die("auth current does not accept a profile name")
            validate_home()
            print(current_details())
        elif command == "login":
            if len(positionals) != 1:
                die("auth login requires NAME")
            auth_login(positionals[0], options.force, options.dry_run, options.timeout)
        elif command == "save":
            if len(positionals) != 1:
                die("auth save requires NAME")
            auth_save(positionals[0], options.force, options.dry_run, options.timeout)
        elif command == "use":
            if len(positionals) > 1:
                die("auth use accepts at most one profile name")
            restart = True if options.restart is None else options.restart
            auth_use(
                positionals[0] if positionals else None,
                restart,
                options.force,
                options.dry_run,
                options.timeout,
                internal=options.internal,
            )
        else:
            die("unknown auth command: %s" % command)
        return

    options = parse_options(argv)
    positionals = list(options.positionals)
    if positionals and positionals[0].lower() in {"this", "home", "local", "host", "all", "both", "stamcord", "shared", "deployment"}:
        normalize_target(positionals.pop(0))
    restart = options.restart
    if positionals:
        if restart is not None or len(positionals) != 1:
            die("restart choice was specified more than once")
        restart = normalize_bool(positionals.pop(0))
    if restart is None:
        die("restart choice is required (true or false)")
    control_home(restart, options.force, options.dry_run, options.timeout, options.internal)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except UserError as exc:
        print("error: %s" % exc, file=sys.stderr)
        sys.exit(1)
